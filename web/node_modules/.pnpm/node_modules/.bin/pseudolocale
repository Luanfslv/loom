#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/Users/administrador/Documents/GitHub/loom/web/node_modules/.pnpm/pseudolocale@2.2.0/node_modules/pseudolocale/dist/node_modules:/Users/administrador/Documents/GitHub/loom/web/node_modules/.pnpm/pseudolocale@2.2.0/node_modules/pseudolocale/node_modules:/Users/administrador/Documents/GitHub/loom/web/node_modules/.pnpm/pseudolocale@2.2.0/node_modules:/Users/administrador/Documents/GitHub/loom/web/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/Users/administrador/Documents/GitHub/loom/web/node_modules/.pnpm/pseudolocale@2.2.0/node_modules/pseudolocale/dist/node_modules:/Users/administrador/Documents/GitHub/loom/web/node_modules/.pnpm/pseudolocale@2.2.0/node_modules/pseudolocale/node_modules:/Users/administrador/Documents/GitHub/loom/web/node_modules/.pnpm/pseudolocale@2.2.0/node_modules:/Users/administrador/Documents/GitHub/loom/web/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../pseudolocale/dist/cli.mjs" "$@"
else
  exec node  "$basedir/../pseudolocale/dist/cli.mjs" "$@"
fi
